[run]
source = src
omit =
    tests/*
    */site-packages/*
    */__pycache__/*
    */venv/*
    */.venv/*

[report]
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
    @abstractmethod
