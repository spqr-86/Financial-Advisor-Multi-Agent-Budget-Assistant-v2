FROM python:3.11-slim

WORKDIR /app

# Install poetry
RUN pip install --no-cache-dir poetry

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install dependencies (no dev, no root package)
RUN poetry config virtualenvs.create false \
    && poetry install --without dev --no-root --no-interaction

# Copy only needed source files
COPY src/__init__.py ./src/
COPY src/core/ ./src/core/
COPY src/mcp/ ./src/mcp/

# Copy prompts and credentials (for agent system)
COPY prompts/ ./prompts/
# Note: credentials.json should be mounted or use secret manager
# COPY credentials.json ./credentials.json

# Environment
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PORT=8082

EXPOSE 8082

CMD ["uvicorn", "src.mcp.app:app", "--host", "0.0.0.0", "--port", "8082"]
